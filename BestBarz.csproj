<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BestBarz</RootNamespace>
    <AssemblyName>BestBarz</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.0.0</Version>
    <Product>BestBarz</Product>
    <Description>Edge toolbars for Windows, inspired by Coolbarz.</Description>
    <RepositoryUrl>https://github.com/musikante/BestBarz</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- Read by the About tab; the commit comes from the SDK's InformationalVersion ("1.0.0+sha"). -->
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <!-- The user guide, opened from Global ▸ Help and the About tab. -->
    <None Include="BestBarz.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- Distributed alongside the exe. -->
    <None Include="README.md"     CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSE"       CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
